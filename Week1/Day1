Set this.age=age

Method display():
Print name
Print age

class Dog extends Pet
Attribute isTrained

Constructor (name,age,isTrained)
super(name,age)
Set this.isTrained=IsTrained

Method display():
super.display
print IsTrained

class Cat extends Pet:
Attribute color

Constructor(name,age,color):
